AGENT_EXECUTION_ENABLED=false
INVITE_REGISTRATION_ENABLED=false
REGISTRATION_OTP_SECRET=
MAIL_PROVIDER=disabled
MAIL_FROM=
MAIL_API_KEY=
SMTP_HOST=
