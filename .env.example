APP_ENV=development
DATABASE_PATH=data/shiyu.sqlite3
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=REPLACE_ME
LLM_MODEL=deepseek-chat
ADMIN_USER=REPLACE_WITH_LOCAL_ADMIN
ADMIN_PASSWORD=REPLACE_ME
